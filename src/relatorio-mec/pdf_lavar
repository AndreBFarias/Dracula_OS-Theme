#!/usr/bin/env bash
# Lava o PDF exportado do OnlyOffice IN-PLACE (mesmo nome, substitui o original)
# para o perfil que renderiza integro em qualquer visualizador web (TrueType/
# WinAnsi via pdftocairo) — substitui o ritual iLovePDF + imprimir-para-PDF.
# O docx e a fonte da verdade; o PDF cru e descartavel.
# Uso: relatorio_pdf <arquivo.pdf> [-o saida.pdf]
set -euo pipefail
[ $# -ge 1 ] || { echo "uso: pdf_lavar <arquivo.pdf> [-o saida.pdf]"; exit 1; }
PDF="$1"; SAIDA="$PDF"
[ "${2:-}" = "-o" ] && SAIDA="${3:?uso: pdf_lavar <arquivo.pdf> -o <saida.pdf>}"
case "$PDF" in
  *.pdf) ;;
  *.docx) echo "ERRO: exporte o PDF pelo OnlyOffice primeiro (Arquivo > Baixar como > PDF)"; exit 1 ;;
  *) echo "ERRO: esperado .pdf"; exit 1 ;;
esac
TMP=$(mktemp --suffix=.pdf)
trap 'rm -f "$TMP"' EXIT
pdftocairo -pdf "$PDF" "$TMP"
mv "$TMP" "$SAIDA"
trap - EXIT
echo "PDF lavado: $SAIDA"
