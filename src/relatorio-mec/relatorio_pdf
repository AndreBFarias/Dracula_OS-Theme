#!/usr/bin/env bash
# Lava o PDF exportado do OnlyOffice para o perfil que renderiza integro em
# qualquer visualizador web (TrueType/WinAnsi, via pdftocairo) — substitui o
# ritual iLovePDF + imprimir-para-PDF.
# Fluxo mensal: editar docx no OnlyOffice -> exportar PDF -> relatorio_pdf <pdf>
# Uso: relatorio_pdf <arquivo.pdf> [pasta_saida]
set -euo pipefail
[ $# -ge 1 ] || { echo "uso: relatorio_pdf <arquivo.pdf> [pasta_saida]"; exit 1; }
PDF="$1"; SAIDA="${2:-$(dirname "$PDF")}"
case "$PDF" in
  *.pdf) ;;
  *.docx) echo "ERRO: exporte o PDF pelo OnlyOffice primeiro (Arquivo > Baixar como > PDF) e rode com o .pdf"; exit 1 ;;
  *) echo "ERRO: esperado .pdf"; exit 1 ;;
esac
FINAL="$SAIDA/$(basename "${PDF%.pdf}")_final.pdf"
pdftocairo -pdf "$PDF" "$FINAL"
echo "PDF pronto: $FINAL"
pdffonts "$FINAL" | head -6
