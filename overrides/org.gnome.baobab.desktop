[Desktop Entry]
# [2026-09-15] Escondido do menu a pedido do dono — ferramenta que ele não
# abre pelo launcher. Nada foi desinstalado: continua acessível por nome, por
# associação de arquivo e pelos outros apps. Para trazer de volta, apague este
# arquivo de overrides/ e rode aplicar_overrides.sh.
NoDisplay=true
Name=Disk Usage Analyzer
Comment=Check folder sizes and available disk space
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=storage;space;cleanup;
TryExec=baobab
Exec=baobab %U
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=org.gnome.baobab
Terminal=false
Type=Application
StartupNotify=true
MimeType=inode/directory;
Categories=GTK;GNOME;System;Filesystem;X-GNOME-Utilities;
DBusActivatable=true
X-GNOME-UsesNotifications=true
X-Ubuntu-Gettext-Domain=baobab
